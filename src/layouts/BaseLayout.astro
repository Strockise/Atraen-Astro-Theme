---
/**
 * Base layout for every page.
 *
 * The Webflow runtime (webflow.js + jQuery + GSAP) drives the navbar, tabs, sliders, lightbox, background video
 * and all IX3 animations. IX3 timelines are keyed by the Webflow page id, so every page passes its original
 * `wfPage` id (see the page files). Don't remove the data-wf-* attributes from the markup.
 */
import '../styles/normalize.css';
import '../styles/webflow.css';
import '../styles/atraen-astro-theme.webflow.css';
import '../styles/custom.css';
import ix3PreHide from '../styles/ix3-prehide.css?raw';
import config from '../config/config.json';
import SEO from '../components/global/SEO.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Webflow page id (data-wf-page). Required for the page's IX3 interactions. */
  wfPage: string;
}
const { title, description, image, type, noindex, wfPage } = Astro.props;
---
<!doctype html>
<html data-wf-page={wfPage} data-wf-site={config.webflow.siteId} lang={config.site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} type={type} noindex={noindex} />
    <style is:inline set:html={ix3PreHide}></style>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/js/vendor/lenis.css" />
    <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
  </head>
  <body>
    <slot />
    <script>import '../scripts/forms.ts';</script>
    <script is:inline src="/js/vendor/jquery-3.5.1.min.js"></script>
    <script is:inline src="/js/webflow.js"></script>
    <script is:inline src="/js/vendor/gsap.min.js"></script>
    <script is:inline src="/js/vendor/SplitText.min.js"></script>
    <script is:inline src="/js/vendor/ScrollTrigger.min.js"></script>
    <script is:inline src="/js/vendor/lenis.min.js"></script>
    <script is:inline src="/js/site.js"></script>
  </body>
</html>
