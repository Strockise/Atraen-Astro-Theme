---
/** Left/right arrows + numbered dots of the orange Webflow sliders (process, blog). Place inside .w-slider. */
---
<div class="slider-arrow is-left w-slider-arrow-left">
  <div class="slider-arrow-icon w-embed"><svg width="20" height="20" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4.58301 10.001H15.833" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M9.16693 15.002C9.16693 15.002 4.167 11.3195 4.16699 10.0019C4.16698 8.68433 9.16702 5.00195 9.16702 5.00195" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg></div>
</div>
<div class="slider-arrow is-right w-slider-arrow-right">
  <div class="slider-arrow-icon w-embed"><svg width="20" height="20" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M15.417 9.99805L4.16699 9.99805" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M10.8331 4.99801C10.8331 4.99801 15.833 8.68051 15.833 9.99809C15.833 11.3157 10.833 14.998 10.833 14.998" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg></div>
</div>
<div class="slide-nave w-slider-nav w-round w-num"></div>
