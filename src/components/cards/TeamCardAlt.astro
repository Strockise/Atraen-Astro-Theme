---
import type { TeamMember } from '../../lib/types';

interface Props {
  item: TeamMember;
}
const { item } = Astro.props;
const itemUrl = `/team/${item.slug}`;
---
<div class="team-content-wrap-v1">
  <a aria-label="team-image-link" href={itemUrl} class="team-image-link w-inline-block"><img loading="lazy" src={item.image?.url} alt={item.image?.alt ?? "team-image"} class="team-image" srcset={item.image?.srcset}></a>
  <div class="team-content-details-block">
    <div class="team-content-details">
      <a aria-label="team-title-link" href={itemUrl} class="team-title-link w-inline-block">
        <div class>{item.name}</div>
      </a>
      <div class="body-text-sm">{item.position}</div>
    </div>
    <div class="team-icon-block">
      <div class="team-arrow-icon w-embed"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12.7685 3.61977L6.66541 3.61977C6.39233 3.61977 6.17095 3.84115 6.17095 4.11423C6.17095 4.38729 6.3923 4.60866 6.66536 4.60869L12.6279 4.60933L4.07294 13.1643C3.87982 13.3574 3.87982 13.6705 4.07294 13.8637C4.26606 14.0568 4.57916 14.0568 4.77228 13.8637L13.3287 5.30727L13.328 11.2712C13.328 11.5443 13.5494 11.7657 13.8225 11.7657C14.0955 11.7657 14.3169 11.5443 14.3169 11.2713L14.3175 5.1688C14.3175 4.75479 14.156 4.36526 13.8637 4.07294C13.5713 3.78062 13.1818 3.61907 12.7692 3.62047L12.7685 3.61977Z" fill="currentColor"></path>
        </svg>
      </div>
    </div>
  </div>
</div>
