---
import type { Blog } from '../../lib/types';
import { formatDate } from '../../lib/cms';

interface Props {
  item: Blog;
}
const { item } = Astro.props;
const itemUrl = `/blogs/${item.slug}`;
---
<div class="blog-card">
  <a href={itemUrl} class="blog-image-block w-inline-block"><img loading="lazy" src={item.mainImage?.url} alt={item.mainImage?.alt ?? "blog-image"} class="blog-image" srcset={item.mainImage?.srcset}></a>
  <div class="blog-content-wrap">
    <div class="blog-date-wrapper">
      <div class="blog-icon w-embed"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g clip-path="url(#clip0_660_6210)">
            <path d="M16.25 1.66667H15V0.416667C15 0.30616 14.9561 0.200179 14.878 0.122039C14.7998 0.0438987 14.6938 0 14.5833 0C14.4728 0 14.3668 0.0438987 14.2887 0.122039C14.2106 0.200179 14.1667 0.30616 14.1667 0.416667V1.66667H5.83333V0.416667C5.83333 0.30616 5.78943 0.200179 5.71129 0.122039C5.63315 0.0438987 5.52717 0 5.41667 0C5.30616 0 5.20018 0.0438987 5.12204 0.122039C5.0439 0.200179 5 0.30616 5 0.416667V1.66667H3.75C2.75578 1.66777 1.80259 2.06321 1.09957 2.76623C0.396545 3.46926 0.00110286 4.42244 0 5.41667L0 16.25C0 18.3175 1.6825 20 3.75 20H16.25C18.3175 20 20 18.3175 20 16.25V5.41667C20 3.34917 18.3175 1.66667 16.25 1.66667ZM3.75 2.5H16.25C17.8583 2.5 19.1667 3.80833 19.1667 5.41667V6.66667H0.833333V5.41667C0.833333 3.80833 2.14167 2.5 3.75 2.5ZM16.25 19.1667H3.75C2.14167 19.1667 0.833333 17.8583 0.833333 16.25V7.5H19.1667V16.25C19.1667 17.8583 17.8583 19.1667 16.25 19.1667ZM13.3333 12.9167C13.3333 13.0272 13.2894 13.1332 13.2113 13.2113C13.1332 13.2894 13.0272 13.3333 12.9167 13.3333H7.08333C6.97283 13.3333 6.86685 13.2894 6.7887 13.2113C6.71057 13.1332 6.66667 13.0272 6.66667 12.9167C6.66667 12.8062 6.71057 12.7002 6.7887 12.622C6.86685 12.5439 6.97283 12.5 7.08333 12.5H12.9167C13.0272 12.5 13.1332 12.5439 13.2113 12.622C13.2894 12.7002 13.3333 12.8062 13.3333 12.9167Z" fill="#676767"></path>
          </g>
          <defs>
            <clipPath id="clip0_660_6210">
              <rect width="20" height="20" fill="white"></rect>
            </clipPath>
          </defs>
        </svg>
      </div>
      <div class="blog-date">{formatDate(item.date)}</div>
    </div>
    <a aria-label="blog-title-link" href={itemUrl} class="blog-title-link w-inline-block">
      <div class="blog-title">{item.title}</div>
    </a>
    <a href={itemUrl} class="blog-link-wrap w-inline-block">
      <div class="blog-text">Read More</div>
      <div class="w-embed"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11.0958 6.00001L5.96789 6.00001C5.73844 6.00001 5.55243 6.18601 5.55243 6.41546C5.55243 6.64489 5.73841 6.83089 5.96784 6.83092L10.9777 6.83146L3.78963 14.0196C3.62737 14.1818 3.62737 14.4449 3.78963 14.6072C3.9519 14.7694 4.21497 14.7694 4.37723 14.6072L11.5665 7.41789L11.566 12.4289C11.5659 12.6583 11.752 12.8444 11.9814 12.8444C12.2108 12.8444 12.3968 12.6584 12.3968 12.429L12.3974 7.30154C12.3974 6.95368 12.2616 6.62639 12.016 6.38077C11.7704 6.13516 11.4425 5.99883 11.0958 6.00001Z" fill="currentColor"></path>
        </svg>
      </div>
    </a>
  </div>
</div>
