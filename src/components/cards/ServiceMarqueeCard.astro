---
import type { Service } from '../../lib/types';

interface Props {
  item: Service;
}
const { item } = Astro.props;
const itemUrl = `/services/${item.slug}`;
---
<div class="service-card-content">
  <div class="service-image-block-v2">
    <a href={itemUrl} class="service-image-link w-inline-block"><img loading="lazy" src={item.mainImage?.url} alt={item.mainImage?.alt ?? "service-image"} class="service-image max-width-34" srcset={item.mainImage?.srcset} sizes="(max-width: 767px) 100vw, (max-width: 991px) 727px, 939px"></a>
    <div class="service-overlay"></div>
  </div>
  <div class="service-content-block-v2">
    <a href={itemUrl} class="service-title-link w-inline-block">
      <h3 class="service-card-title">{item.title}</h3>
    </a>
    <p class="body-text-md text-color-white">{item.summary}</p>
  </div>
  <a href={itemUrl} class="service-icon-block w-inline-block">
    <div class="service-icon w-embed"><svg width="39" height="32" viewBox="0 0 39 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M37.2006 12.9588L25.213 0.971207C24.6766 0.434824 23.807 0.434824 23.2706 0.971207C22.7342 1.50755 22.7342 2.37712 23.2705 2.91352L34.9808 14.6264L1.37362 14.6264C0.614991 14.6264 0 15.2414 0 16C0 16.7587 0.614994 17.3736 1.37363 17.3736L34.9863 17.3736L23.2708 29.0866C22.7344 29.6229 22.7343 30.4926 23.2707 31.029C23.8071 31.5653 24.6766 31.5654 25.2129 31.0291L37.2006 19.044C38.0138 18.2308 38.4616 17.1484 38.4616 16C38.4616 14.8517 38.0138 13.7692 37.2006 12.9616V12.9588Z" fill="#4E6E40"></path>
      </svg>
    </div>
  </a>
</div>
