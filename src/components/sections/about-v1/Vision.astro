---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section-vision">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="vision-wrapper">
        <div class="vision-left-content">
          <div class="vision-content-wrapper">
            <div page-scroll-0="" class="vision-title-block">
              <SectionTitle text="OUR VISION" />
            </div>
            <div class="section-header-block">
              <h2 title-scroll="" class="heading-style-2">Building Future-Ready Organizations</h2>
            </div>
            <div page-scroll-2="" class="section-summary-block is-top-gap">
              <p class="vision-summary">Our vision is to become a trusted consulting partner recognized for driving innovation, excellence, and lasting business impact. We strive to empower organizations with the expertise, guidance, and confidence needed to thrive in an evolving marketplace.</p>
            </div>
          </div>
        </div>
        <div page-scroll-1="" class="vision-image-block"><img src="/images/vision-Image.webp" loading="lazy" sizes="100vw" srcset="/images/vision-Image-p-500.webp 500w, /images/vision-Image-p-800.webp 800w, /images/vision-Image.webp 945w" alt="vision-image" class="vision-image"></div>
      </div>
    </div>
  </div>
</section>
