---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_about-hero">
  <div class="about-hero-bg-color">
    <div class="w-layout-blockcontainer container-full w-container">
      <div class="about-hero-wrapper">
        <div class="about-hero-top">
          <div page-load-0="" class="about-hero-title-block">
            <SectionTitle text="ABOUT US" variant="light" />
          </div>
          <div class="section-header-block">
            <h1 heading-title="" class="heading-style-1 text-color-white">Guiding Ambitious Businesses Toward Lasting Success</h1>
          </div>
        </div>
        <div page-load-1="" class="about-hero-bottom">
          <div class="about-hero-image-wrapper">
            <div class="about-hero-image-wrap">
              <div class="about-hero-image-block"><img src="/images/About-Image-5.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-5-p-500.webp 500w, /images/About-Image-5.webp 615w" alt="about-hero-image" class="about-hero-image"></div>
              <div class="about-hero-image-block"><img src="/images/About-Image-4.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-4-p-500.webp 500w, /images/About-Image-4.webp 615w" alt="about-hero-image" class="about-hero-image"></div>
              <div class="about-hero-image-block"><img src="/images/About-Image-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-1-p-500.webp 500w, /images/About-Image-1.webp 615w" alt="about-hero-image" class="about-hero-image"></div>
              <div class="about-hero-image-block"><img src="/images/About-Image-3.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-3-p-500.webp 500w, /images/About-Image-3.webp 615w" alt="about-hero-image" class="about-hero-image"></div>
              <div class="about-hero-image-block"><img src="/images/About-Image-2.png" loading="lazy" sizes="100vw" srcset="/images/About-Image-2-p-500.png 500w, /images/About-Image-2.png 615w" alt="about-hero-image" class="about-hero-image"></div>
            </div>
            <div class="about-hero-image-wrap">
              <div class="about-hero-image-block"><img src="/images/About-Image-5.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-5-p-500.webp 500w, /images/About-Image-5.webp 615w" alt="about-hero-image" class="about-hero-image"></div>
              <div class="about-hero-image-block"><img src="/images/About-Image-4.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-4-p-500.webp 500w, /images/About-Image-4.webp 615w" alt="about-hero-image" class="about-hero-image"></div>
              <div class="about-hero-image-block"><img src="/images/About-Image-1.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-1-p-500.webp 500w, /images/About-Image-1.webp 615w" alt="about-hero-image" class="about-hero-image"></div>
              <div class="about-hero-image-block"><img src="/images/About-Image-3.webp" loading="lazy" sizes="100vw" srcset="/images/About-Image-3-p-500.webp 500w, /images/About-Image-3.webp 615w" alt="about-hero-image" class="about-hero-image"></div>
              <div class="about-hero-image-block"><img src="/images/About-Image-2.png" loading="lazy" sizes="100vw" srcset="/images/About-Image-2-p-500.png 500w, /images/About-Image-2.png 615w" alt="about-hero-image" class="about-hero-image"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
