---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section-mission">
  <div class="w-layout-blockcontainer container-main w-container">
    <div class="mission-wrapper">
      <div page-scroll-0="" class="mission-image-block"><img src="/images/Mission-Image.webp" loading="lazy" sizes="100vw" srcset="/images/56120e0342323ff9d5556d39d6e1d047_Mission-Image-p-500.webp 500w, /images/56120e0342323ff9d5556d39d6e1d047_Mission-Image-p-800.webp 800w, /images/Mission-Image.webp 945w" alt="mission-image" class="mission-image is-01"></div>
      <div class="mission-left-content">
        <div class="mission-content-wrapper">
          <div page-scroll-0="" class="mission-title-block">
            <SectionTitle text="OUR MISSION" />
          </div>
          <div class="section-header-block">
            <h2 title-scroll="" class="heading-style-2">Driving Sustainable Business Growth</h2>
          </div>
          <div page-scroll-2="" class="section-summary-block is-top-gap">
            <p class="mission-summary">Our mission is to help organizations overcome challenges, unlock opportunities, and achieve long-term success through strategic consulting. We work closely with our clients to deliver practical solutions that drive measurable results, improve performance, and support sustainable business growth.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
