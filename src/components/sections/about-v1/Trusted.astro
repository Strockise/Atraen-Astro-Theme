---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_trusted">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="trusted-wrapper">
        <div class="trusted-title-block">
          <div page-scroll-0="" class="trusted-title-block">
            <SectionTitle text="TRUSTED BY GROWTH-DRIVEN BUSINESSES" />
          </div>
          <div class="section-header-block">
            <h2 page-scroll-1="" class="heading-style-2 about-header">Every strategy we create—from planning to execution—is built to help businesses grow with confidence. We combine industry expertise, data-driven insights, and innovative thinking to deliver solutions that create measurable and lasting impact.</h2>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
