---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section-spproach">
  <div class="approach-bg-color">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="approach-wrapper">
        <div class="approach-top-wrapper">
          <div class="approach-header-block">
            <div page-scroll-0="" class="approach-title-block">
              <SectionTitle text="OUR APPROACH" variant="light" />
            </div>
            <div class="section-header-block max-width-53">
              <h2 title-scroll="" class="heading-style-2 text-color-white">Exceptional consulting support — clear insights, actionable strategies,  and measurable results that strengthened our business performance.</h2>
            </div>
          </div>
          <div class="approach-image-wrapper">
            <div page-scroll-2="" class="approach-small-image-block"><img src="/images/approach-Image-1.webp" loading="lazy" alt="approach-small-image" class="approach-small-image"></div>
            <div page-scroll-3="" class="approach-large-image-block"><img src="/images/approach-Image-2.webp" loading="lazy" sizes="100vw" srcset="/images/approach-Image-2-p-500.webp 500w, /images/approach-Image-2-p-800.webp 800w, /images/approach-Image-2.webp 945w" alt="approach-large-image" class="approach-large-image"></div>
          </div>
        </div>
        <div class="approach-bottom-wrapper">
          <div class="approach-counter-wrapper">
            <div page-scroll-0="" class="approach-counter-wrap is-01">
              <div class="approach-counter-line"></div>
              <div class="apprach-counter-block is-01">
                <div class="approach-counter-text">SUCCESSFUL PROJECTS DELIVERED</div>
                <div class="approach-counter-number-block">
                  <h3 class="approach-counter-number counter-anim">500+</h3>
                </div>
              </div>
              <div class="approach-counter-line"></div>
            </div>
            <div page-scroll-1="" class="approach-counter-wrap is-02">
              <div class="apprach-counter-block is-02">
                <div class="approach-counter-text">YEARS OF INDUSTRY EXPERIENCE</div>
                <div class="approach-counter-number-block">
                  <h3 class="approach-counter-number counter-anim">15+</h3>
                </div>
              </div>
            </div>
            <div page-scroll-2="" class="approach-counter-wrap is-03">
              <div class="approach-counter-line"></div>
              <div class="apprach-counter-block is-03">
                <div class="approach-counter-text">REVENUE GROWTH SUPPORTED</div>
                <div class="approach-counter-number-block">
                  <h3 class="approach-counter-number counter-anim">120M+</h3>
                </div>
              </div>
            </div>
            <div page-scroll-3="" class="approach-counter-wrap is-04">
              <div class="approach-counter-line"></div>
              <div class="apprach-counter-block is-04">
                <div class="approach-counter-text">CLIENT SATISFACTION RATE</div>
                <div class="approach-counter-number-block">
                  <h3 class="approach-counter-number counter-anim">98%</h3>
                </div>
              </div>
              <div class="approach-counter-line"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
