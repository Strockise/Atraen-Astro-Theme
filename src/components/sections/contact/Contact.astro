<section class="section-contact">
  <div class="contact-section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="contact-wrapper">
        <div data-wf-target="[[[&quot;6abe84b3182afe641eb8e34e&quot;,&quot;2cf10885-71f6-2e96-9f46-29a96b75a75b&quot;],[]]]" class="contact-top-wrapper">
          <div class="section-header-block">
            <h1 class="heading-style-h1">Let’s Start the Conversation</h1>
          </div>
          <div class="section-summary-block max-width-41-75rem">
            <p class="body-text-main">Whether you’re facing a challenge, planning your next move, or simply looking for clarity, I’m here to help you move forward with confidence.</p>
          </div>
        </div>
        <div class="contact-form-wrapper">
          <div class="contact-form-block w-form">
            <form method="get" name="email-form" data-name="Email Form" class="contact-form-wrap" data-wf-page-id="6abe84b3182afe641eb8e34e" data-wf-element-id="6beb7270-8150-95fb-4cde-74a3cd585f64">
              <div class="contact-form-flex-vetical">
                <div class="contact-form-flex">
                  <div class="contact-form"><label for="name" class="contact-form-label">First name</label><input class="contact-form-field w-input" maxlength="256" name="name" data-name="Name" placeholder="First name" type="text"></div>
                  <div class="contact-form"><label for="name" class="contact-form-label">Last name</label><input class="contact-form-field w-input" maxlength="256" name="name" data-name="Name" placeholder="Last name" type="text"></div>
                </div>
                <div class="contact-form"><label for="name" class="contact-form-label">Email address</label><input class="contact-form-field w-input" maxlength="256" name="name" data-name="Name" placeholder="Your email address" type="text" id="name"></div>
                <div class="contact-form"><label for="field" class="contact-form-label">Service Interested In</label><select id="field" name="field" data-name="Field" class="contact-form-field is-form-selected w-select">
                    <option value="">Career Strategy</option>
                    <option value="First">First choice</option>
                    <option value="Second">Second choice</option>
                    <option value="Third">Third choice</option>
                  </select></div>
                <div class="contact-form"><label for="field-2" class="contact-form-label">Messages</label><textarea placeholder="Your message here.." maxlength="5000" id="field-2" name="field-2" data-name="Field 2" class="contact-form-field is-form-text w-input"></textarea></div>
              </div><input type="submit" data-wait="Please wait..." class="contact-form-button w-button" value="Send Message">
            </form>
            <div class="w-form-done">
              <div>Thank you! Your submission has been received!</div>
            </div>
            <div class="w-form-fail">
              <div>Oops! Something went wrong while submitting the form.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
