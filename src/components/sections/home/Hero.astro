---
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<section class="section_hero">
  <div class="w-layout-blockcontainer container-main w-container">
    <div class="hero-wrapper">
      <div page-load-0="" class="hero-title-block">
        <div class="body-text-sm text-color-white font-weight-medium">GROWTH-FOCUSED CONSULTING</div>
      </div>
      <div class="section-header-block is-hero-gap">
        <h1 heading-title="" class="heading-style-1 text-color-white">Empowering Modern Companies With Smart Business Solutions</h1>
      </div>
      <div page-load-1="" class="hero-button-block">
        <PrimaryButton href="#" text="Free Consultation" />
      </div>
    </div>
    <div class="hero-image-wrapper"><img src="/images/Hero-Image-1_1.webp" loading="lazy" alt="hero-image" class="hero-image">
      <div class="hero-image-overlay"></div>
    </div>
    <div class="hero-gradient"></div>
  </div>
</section>
