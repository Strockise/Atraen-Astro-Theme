---
import PrimaryButton from '../../global/PrimaryButton.astro';
---
<section class="section-real-result">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="real-result-wrapper">
        <div class="real-result-content-block">
          <div scroll="scroll interaction" data-current="Tab 1" data-easing="ease" data-duration-in="300" data-duration-out="100" class="real-result-tabs-block w-tabs">
            <div scroll="scroll interaction" class="real-result-tabs-menu w-tab-menu">
              <a data-w-tab="Tab 1" class="real-life-tab-link is-01 w-inline-block w-tab-link w--current">
                <div class="real-result-content-wrap">
                  <div class="real-result-top-content">
                    <div class="real-result-question-block">
                      <div class="real-resutl-question">The Challenge</div>
                    </div>
                    <div class="faq-icon-block">
                      <div class="faq-icon"></div>
                      <div class="faq-icon is-01 is-rotate-01"></div>
                    </div>
                  </div>
                  <div class="real-result-detailst-block is-01">
                    <div class="real-result-top-gap">
                      <p class="real-result-text">Lack of clear direction, low confidence in decision-making, and confusion about the next career step.</p>
                    </div>
                  </div>
                </div>
              </a>
              <a data-w-tab="Tab 2" class="real-life-tab-link is-02 w-inline-block w-tab-link">
                <div class="real-result-content-wrap">
                  <div class="real-result-top-content">
                    <div class="real-result-question-block">
                      <div class="real-resutl-question">My Approach</div>
                    </div>
                    <div class="faq-icon-block">
                      <div class="faq-icon"></div>
                      <div class="faq-icon is-01 is-rotate-02"></div>
                    </div>
                  </div>
                  <div class="real-result-detailst-block is-02">
                    <div class="real-result-top-gap">
                      <p class="real-result-text">Lack of clear direction, low confidence in decision-making, and confusion about the next career step.</p>
                    </div>
                  </div>
                </div>
              </a>
              <a data-w-tab="Tab 3" class="real-life-tab-link is-03 w-inline-block w-tab-link">
                <div class="real-result-content-wrap">
                  <div class="real-result-top-content">
                    <div class="real-result-question-block">
                      <div class="real-resutl-question">The Result</div>
                    </div>
                    <div class="faq-icon-block">
                      <div class="faq-icon"></div>
                      <div class="faq-icon is-01 is-rotate-03"></div>
                    </div>
                  </div>
                  <div class="real-result-detailst-block is-03">
                    <div class="real-result-top-gap">
                      <p class="real-result-text">Lack of clear direction, low confidence in decision-making, and confusion about the next career step.</p>
                    </div>
                  </div>
                </div>
              </a>
            </div>
            <div class="real-result-tab-content w-tab-content">
              <div data-w-tab="Tab 1" class="real-result-tab-pane w-tab-pane w--tab-active">
                <div class="real-result-image-block"><img src="/images/approach-Image-5.webp" loading="lazy" sizes="(max-width: 650px) 100vw, 650px" srcset="/images/50e5976346a52773026a366f66c03378_approach-Image-5-p-500.webp 500w, /images/approach-Image-5.webp 650w" alt="real-result-image" class="real-result-image"></div>
              </div>
              <div data-w-tab="Tab 2" class="real-result-tab-pane w-tab-pane">
                <div class="real-result-image-block"><img src="/images/Real-Result-Image-3_1Real-Result-Image-3.webp" loading="lazy" sizes="100vw" srcset="/images/Real-Result-Image-3_1-p-500.webp 500w, /images/Real-Result-Image-3_1Real-Result-Image-3.webp 650w" alt="real-result-image" class="real-result-image"></div>
              </div>
              <div data-w-tab="Tab 3" class="real-result-tab-pane w-tab-pane">
                <div class="real-result-image-block"><img src="/images/Real-Result-Image-2_1Real-Result-Image-2.webp" loading="lazy" sizes="100vw" srcset="/images/Real-Result-Image-2_1-p-500.webp 500w, /images/Real-Result-Image-2_1Real-Result-Image-2.webp 650w" alt="real-result-image" class="real-result-image"></div>
              </div>
            </div>
          </div>
          <div scroll="scroll interaction" id="w-node-b4634b8b-5082-3545-be5b-9b1940166847-1eb8e343" class="real-result-content-wrapper">
            <div scroll="scroll interaction" class="real-resutl-detail-block">
              <h3 class="real-result-title">Mid-level professional navigating career uncertainty</h3>
              <div class="real-result-summary-block">
                <p class="body-text-main text-color-gray">A genuine illustration of how clarity-driven consulting empowers individuals to progress confidently, overcoming obstacles and achieving their goals with renewed assurance.</p>
              </div>
            </div>
            <div class="real-result-button">
              <PrimaryButton href="/contact" text="Let’s Collaborate" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
