---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_about">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="about-wrapper">
        <div class="about-header-block">
          <div page-scroll-0="" class="about-title-block">
            <SectionTitle text="ABOUT US" />
          </div>
          <div class="section-header-block max-width-55">
            <h2 page-scroll-1="" class="about-header">We partner with ambitious organizations to solve complex challenges, uncover new opportunities, and build strategies that drive measurable results.</h2>
          </div>
        </div>
        <div class="about-content-wrapper">
          <div page-scroll-2="" class="about-counter-wrap">
            <div class="about-counter-wrapper">
              <div class="about-counter-single-card">
                <h3 class="counter-number counter-anim">15+</h3>
                <p class="body-text-md text-color-gray">Years of Industry Experience</p>
              </div>
              <div class="about-counter-single-card">
                <h3 class="counter-number counter-anim">500+</h3>
                <p class="body-text-md text-color-gray">Successful Projects Delivered</p>
              </div>
              <div class="about-counter-single-card">
                <h3 class="counter-number counter-anim">120M+</h3>
                <p class="body-text-md text-color-gray">Revenue Growth Supported</p>
              </div>
              <div class="about-counter-single-card">
                <h3 class="counter-number counter-anim">98%</h3>
                <p class="body-text-md text-color-gray">Client Satisfaction Rate</p>
              </div>
            </div>
          </div>
          <div page-scroll-3="" class="about-image-block"><img src="/images/About-Image.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="/images/About-Image-p-500.webp 500w, /images/About-Image-p-800.webp 800w, /images/About-Image-p-1080.webp 1080w, /images/About-Image.webp 1290w" alt="about-image" class="about-image"></div>
        </div>
      </div>
    </div>
  </div>
</section>
