---
import PrimaryButton from '../../ui/PrimaryButton.astro';
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_service">
  <div class="service-bg-color">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="service-wrapper">
        <div class="service-header-blcok">
          <div page-scroll-0="" class="section-title-block">
            <SectionTitle text="OUR SERVICES" variant="light" />
          </div>
          <div class="section-header-block">
            <h2 title-scroll="" class="heading-style-2 text-color-white">Consulting Services Designed to Accelerate Business Growth</h2>
          </div>
        </div>
        <div class="service-sticky-container-v1">
          <div class="service-sticky-block-v1">
            <div class="service-content-wrapper">
              <div class="service-left-content">
                <div class="service-card-block">
                  <div class="service-single-card is-01">
                    <div class="service-line">
                      <div class="service-line-black is-01"></div>
                    </div>
                    <div class="service-card-text-wrapper is-01">
                      <div class="service-card-title-block">
                        <h3 class="service-card-titile">Business Strategy Consulting</h3>
                      </div>
                      <div class="service-card-text-block is-01">
                        <div class="service-card-gap">
                          <p class="service-card-text">Optimize financial performance through budgeting, forecasting, risk assessment, and data-driven decision-making.</p>
                        </div>
                      </div>
                    </div>
                    <div class="service-line">
                      <div class="service-line-black is-02"></div>
                    </div>
                  </div>
                  <div class="service-single-card is-02">
                    <div class="service-card-text-wrapper is-02">
                      <div class="service-card-title-block">
                        <h3 class="service-card-titile">Financial Advisory</h3>
                      </div>
                      <div class="service-card-text-block is-o2">
                        <div class="service-card-gap">
                          <p class="service-card-text">Optimize financial performance through budgeting, forecasting, risk assessment, and data-driven decision-making.</p>
                        </div>
                      </div>
                    </div>
                    <div class="service-line">
                      <div class="service-line-black is-03"></div>
                    </div>
                  </div>
                  <div class="service-single-card is-03">
                    <div class="service-card-text-wrapper is-03">
                      <div class="service-card-title-block">
                        <h3 class="service-card-titile">Market Research &amp; Analysis</h3>
                      </div>
                      <div class="service-card-text-block is-03">
                        <div class="service-card-gap">
                          <p class="service-card-text">Optimize financial performance through budgeting, forecasting, risk assessment, and data-driven decision-making.</p>
                        </div>
                      </div>
                    </div>
                    <div class="service-line">
                      <div class="service-line-black is-04"></div>
                    </div>
                  </div>
                  <div class="service-single-card is-04">
                    <div class="service-card-text-wrapper is04">
                      <div class="service-card-title-block">
                        <h3 class="service-card-titile">Operations Consulting</h3>
                      </div>
                      <div class="service-card-text-block is-04">
                        <div class="service-card-gap">
                          <p class="service-card-text">Optimize financial performance through budgeting, forecasting, risk assessment, and data-driven decision-making.</p>
                        </div>
                      </div>
                    </div>
                    <div class="service-line">
                      <div class="service-line-black is-05"></div>
                    </div>
                  </div>
                </div>
                <div class="service-bottom-content-block">
                  <p page-scroll-1="" class="body-text-md text-color-white line-height-lg">From strategic planning to operational improvement, our consulting services help organizations navigate challenges, seize opportunities, and achieve sustainable success in a competitive market.</p>
                  <div page-scroll-2="" class="service-button-block">
                    <PrimaryButton href="/services" text="View all Services" variant="accent" />
                  </div>
                </div>
              </div>
              <div class="service-right-content">
                <div class="service-image-block is-01"><img src="/images/Service-Image-1.webp" loading="lazy" sizes="(max-width: 630px) 100vw, 630px" srcset="/images/Service-Image-1-p-500.webp 500w, /images/Service-Image-1.webp 630w" alt="service-image" class="service-image"></div>
                <div class="service-image-block is-02"><img src="/images/Service-Image-4_1.webp" loading="lazy" sizes="(max-width: 630px) 100vw, 630px" srcset="/images/Service-Image-4_1-p-500.webp 500w, /images/Service-Image-4_1.webp 630w" alt="service-image" class="service-image"></div>
                <div class="service-image-block is-03"><img src="/images/Service-Image-3_1.webp" loading="lazy" sizes="(max-width: 630px) 100vw, 630px" srcset="/images/Service-Image-3_1-p-500.webp 500w, /images/Service-Image-3_1.webp 630w" alt="service-image" class="service-image"></div>
                <div class="service-image-block is-04"><img src="/images/Service-Image-2_1.webp" loading="lazy" sizes="(max-width: 630px) 100vw, 630px" srcset="/images/Service-Image-2_1-p-500.webp 500w, /images/Service-Image-2_1.webp 630w" alt="service-image" class="service-image"></div>
                <div class="service-image-block is-05"><img src="/images/Service-Image-1_1.webp" loading="lazy" sizes="(max-width: 630px) 100vw, 630px" srcset="/images/Service-Image-1_1-p-500.webp 500w, /images/Service-Image-1_1.webp 630w" alt="service-image" class="service-image"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
