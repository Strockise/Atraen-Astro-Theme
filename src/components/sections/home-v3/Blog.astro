---
import SectionTitle from '../../ui/SectionTitle.astro';
import BlogCardAlt from '../../cards/BlogCardAlt.astro';
import { getBlogs, take } from '../../../lib/cms';

const blogs = await getBlogs();
---
<section class="section-blog">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="blog-wrapper-v3">
        <div class="blog-header-wrapper">
          <div class="section-title-block">
            <SectionTitle text="ABOUT US" />
          </div>
          <div class="section-header-block">
            <h2 class="heading-style-2">Insights, Strategies and Business Growth Ideas</h2>
          </div>
        </div>
        <div class="blog-content-wrapper-v3">
          <div data-delay="4000" data-animation="slide" class="blog-slider-block w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
            <div class="blog-slider-mask w-slider-mask">
              <div class="blog-slider w-slide">
                <div class="blog-collection-list-wrapper w-dyn-list">
                  <div role="list" class="blog-collection-list-v2 is-block w-dyn-items">{take(blogs, 1).map((entry) => (<div page-scroll-2="" role="listitem" class="blog-collection-item w-dyn-item"><BlogCardAlt item={entry} /></div>))}</div>
                  {take(blogs, 1).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
                </div>
              </div>
              <div class="blog-slider is-top-gap w-slide">
                <div class="blog-collection-list-wrapper w-dyn-list">
                  <div role="list" class="blog-collection-list-v2 is-block w-dyn-items">{take(blogs, 1, 1).map((entry) => (<div page-scroll-2="" role="listitem" class="blog-collection-item w-dyn-item"><BlogCardAlt item={entry} /></div>))}</div>
                  {take(blogs, 1, 1).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
                </div>
              </div>
              <div class="blog-slider w-slide">
                <div class="blog-collection-list-wrapper w-dyn-list">
                  <div role="list" class="blog-collection-list-v2 is-block w-dyn-items">{take(blogs, 1, 2).map((entry) => (<div page-scroll-2="" role="listitem" class="blog-collection-item w-dyn-item"><BlogCardAlt item={entry} /></div>))}</div>
                  {take(blogs, 1, 2).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
                </div>
              </div>
              <div class="blog-slider is-top-gap w-slide">
                <div class="blog-collection-list-wrapper w-dyn-list">
                  <div role="list" class="blog-collection-list-v2 is-block w-dyn-items">{take(blogs, 1, 3).map((entry) => (<div page-scroll-2="" role="listitem" class="blog-collection-item w-dyn-item"><BlogCardAlt item={entry} /></div>))}</div>
                  {take(blogs, 1, 3).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
                </div>
              </div>
              <div class="blog-slider w-slide">
                <div class="blog-collection-list-wrapper w-dyn-list">
                  <div role="list" class="blog-collection-list-v2 is-block w-dyn-items">{take(blogs, 1, 4).map((entry) => (<div page-scroll-2="" role="listitem" class="blog-collection-item w-dyn-item"><BlogCardAlt item={entry} /></div>))}</div>
                  {take(blogs, 1, 4).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
                </div>
              </div>
            </div>
            <div class="blog-arrow is-left w-slider-arrow-left">
              <div class="blog-arrow-icon w-embed"><svg width="20" height="17" viewBox="0 0 20 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0.655715 9.90144L6.88926 16.135C7.16818 16.4139 7.6204 16.4139 7.89932 16.135C8.17822 15.8561 8.17824 15.4039 7.89937 15.125L1.81 9.0343L19.2857 9.0343C19.6802 9.0343 20 8.7145 20 8.32001C20 7.92552 19.6802 7.60573 19.2857 7.60573L1.80714 7.60573L7.89918 1.515C8.17814 1.23611 8.17816 0.783874 7.89924 0.504948C7.62036 0.226065 7.1682 0.226041 6.88929 0.504895L0.655715 6.73715C0.232856 7.16001 7.79562e-07 7.72287 7.27359e-07 8.32001C6.75155e-07 8.91716 0.232855 9.48001 0.655715 9.90001L0.655715 9.90144Z" fill="currentColor"></path>
                </svg>
              </div>
            </div>
            <div class="blog-arrow w-slider-arrow-right">
              <div class="blog-arrow-icon w-embed"><svg width="20" height="17" viewBox="0 0 20 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M19.3443 6.73858L13.1108 0.505028C12.8318 0.226109 12.3796 0.226109 12.1007 0.505028C11.8218 0.783926 11.8218 1.2361 12.1006 1.51503L18.19 7.60573L0.714287 7.60573C0.319797 7.60573 0 7.92552 0 8.32001C0 8.7145 0.319797 9.0343 0.714287 9.0343L18.1929 9.0343L12.1008 15.125C11.8219 15.4039 11.8219 15.8562 12.1008 16.1351C12.3797 16.414 12.8318 16.414 13.1107 16.1351L19.3443 9.90287C19.7672 9.48001 20 8.91716 20 8.32001C20 7.72287 19.7672 7.16001 19.3443 6.74001V6.73858Z" fill="currentColor"></path>
                </svg>
              </div>
            </div>
            <div class="slide-nav w-slider-nav w-round w-num"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
