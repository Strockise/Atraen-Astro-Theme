---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section-testimonial">
  <div class="testimonial-bg-color">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="testimonial-wrapper text-align-left">
        <div class="testimonial-top-wrapper is-max-width-mobile">
          <div page-scroll-0="" class="testimonial-title-block">
            <SectionTitle text="OUR EXPERTISE" />
          </div>
          <div class="section-header-block">
            <h2 title-scroll="" class="heading-style-2">Meet the Experts Behind Clavix Success</h2>
          </div>
        </div>
        <div page-scroll-2="" class="testimonial-content-wrapper-v3">
          <div data-delay="4000" data-animation="slide" class="testimonial-slider-block is-gap w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
            <div class="testimonial-slider-mask v3 w-slider-mask">
              <div class="testimonial-sliderv3 w-slide">
                <div class="testimonial-single-card">
                  <div class="testimonial-left-content">
                    <div class="testimonial-image-circle-block"><img src="/images/Testimonial-Image-1_1Testimonial-Image-1.png" loading="lazy" alt="testimonial-image-circle" class="testimonial-image-circle"></div>
                    <div class="testimonial-avatar-wrap">
                      <div class="testimonial-avatar-name">Michael Reynolds</div>
                      <div class="body-text-md text-color-white">CEO, BrightEdge Solutions</div>
                    </div>
                  </div>
                  <div class="testimonial-right-content">
                    <div class="testimonial-icon-block">
                      <div class="w-embed"><svg width="79" height="61" viewBox="0 0 79 61" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <g opacity="0.1">
                            <path d="M78.3676 61H49.4453V33.1604H78.3676V61ZM63.6694 54.1589H49.4453V26.5093C49.4453 18.2747 51.8792 11.8136 56.747 7.12617C61.678 2.37539 68.6004 0 77.5141 0V13.0171C73.2153 13.0171 69.8331 14.1257 67.3676 16.3427C64.9021 18.4964 63.6694 21.8219 63.6694 26.3193V54.1589Z" fill="#676767"></path>
                            <path d="M28.9223 61H0V33.1604H28.9223V61ZM14.2241 54.1589H0V26.5093C0 18.2747 2.4339 11.8136 7.30169 7.12617C12.2327 2.37539 19.1551 0 28.0688 0V13.0171C23.77 13.0171 20.3878 14.1257 17.9223 16.3427C15.4568 18.4964 14.2241 21.8219 14.2241 26.3193V54.1589Z" fill="#676767"></path>
                          </g>
                        </svg>
                      </div>
                    </div>
                    <div class="testimonial-details-wrap">
                      <h3 class="testimonia-title">Outstanding Strategic Business Guidance</h3>
                      <div class="testimonial-line"></div>
                      <p class="body-text-md text-color-gray">Clavix completely transformed how we approach business strategy. Their insights were practical, data-driven, and directly improved our decision-making process. We’ve seen consistent growth since working with them.</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="testimonial-sliderv3 w-slide">
                <div class="testimonial-single-card">
                  <div class="testimonial-left-content">
                    <div class="testimonial-image-circle-block"><img src="/images/Testimonial-Image-1_1Testimonial-Image-1.png" loading="lazy" alt="testimonial-image-circle" class="testimonial-image-circle"></div>
                    <div class="testimonial-avatar-wrap">
                      <div class="testimonial-avatar-name">Michael Thompson</div>
                      <div class="body-text-md text-color-white">Founder, UrbanNest</div>
                    </div>
                  </div>
                  <div class="testimonial-right-content">
                    <div class="testimonial-icon-block">
                      <div class="w-embed"><svg width="79" height="61" viewBox="0 0 79 61" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <g opacity="0.1">
                            <path d="M78.3676 61H49.4453V33.1604H78.3676V61ZM63.6694 54.1589H49.4453V26.5093C49.4453 18.2747 51.8792 11.8136 56.747 7.12617C61.678 2.37539 68.6004 0 77.5141 0V13.0171C73.2153 13.0171 69.8331 14.1257 67.3676 16.3427C64.9021 18.4964 63.6694 21.8219 63.6694 26.3193V54.1589Z" fill="#676767"></path>
                            <path d="M28.9223 61H0V33.1604H28.9223V61ZM14.2241 54.1589H0V26.5093C0 18.2747 2.4339 11.8136 7.30169 7.12617C12.2327 2.37539 19.1551 0 28.0688 0V13.0171C23.77 13.0171 20.3878 14.1257 17.9223 16.3427C15.4568 18.4964 14.2241 21.8219 14.2241 26.3193V54.1589Z" fill="#676767"></path>
                          </g>
                        </svg>
                      </div>
                    </div>
                    <div class="testimonial-details-wrap">
                      <h3 class="testimonia-title">A Truly Reliable Growth Consulting Partner</h3>
                      <div class="testimonial-line"></div>
                      <p class="body-text-md text-color-gray">The Clavix team didn’t just consult—they collaborated with us like an internal team. Their marketing strategies helped us improve lead quality and reduce acquisition costs significantly.</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="testimonial-sliderv3 w-slide">
                <div class="testimonial-single-card">
                  <div class="testimonial-left-content">
                    <div class="testimonial-image-circle-block"><img src="/images/Testimonial-Image-1_1Testimonial-Image-1.png" loading="lazy" alt="testimonial-image-circle" class="testimonial-image-circle"></div>
                    <div class="testimonial-avatar-wrap">
                      <h4 class="testimonial-avatar-name">Michael Reynolds</h4>
                      <div class="body-text-md text-color-white">CEO, BrightEdge Solutions</div>
                    </div>
                  </div>
                  <div class="testimonial-right-content">
                    <div class="testimonial-icon-block">
                      <div class="w-embed"><svg width="79" height="61" viewBox="0 0 79 61" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <g opacity="0.1">
                            <path d="M78.3676 61H49.4453V33.1604H78.3676V61ZM63.6694 54.1589H49.4453V26.5093C49.4453 18.2747 51.8792 11.8136 56.747 7.12617C61.678 2.37539 68.6004 0 77.5141 0V13.0171C73.2153 13.0171 69.8331 14.1257 67.3676 16.3427C64.9021 18.4964 63.6694 21.8219 63.6694 26.3193V54.1589Z" fill="#676767"></path>
                            <path d="M28.9223 61H0V33.1604H28.9223V61ZM14.2241 54.1589H0V26.5093C0 18.2747 2.4339 11.8136 7.30169 7.12617C12.2327 2.37539 19.1551 0 28.0688 0V13.0171C23.77 13.0171 20.3878 14.1257 17.9223 16.3427C15.4568 18.4964 14.2241 21.8219 14.2241 26.3193V54.1589Z" fill="#676767"></path>
                          </g>
                        </svg>
                      </div>
                    </div>
                    <div class="testimonial-details-wrap">
                      <h3 class="testimonia-title">Outstanding Strategic Business Guidance</h3>
                      <div class="testimonial-line"></div>
                      <p class="body-text-md text-color-gray">Clavix completely transformed how we approach business strategy. Their insights were practical, data-driven, and directly improved our decision-making process. We’ve seen consistent growth since working with them.</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="testimonial-sliderv3 w-slide">
                <div class="testimonial-single-card">
                  <div class="testimonial-left-content">
                    <div class="testimonial-image-circle-block"><img src="/images/Testimonial-Image-1_1Testimonial-Image-1.png" loading="lazy" alt="testimonial-image-circle" class="testimonial-image-circle"></div>
                    <div class="testimonial-avatar-wrap">
                      <h4 class="testimonial-avatar-name">Michael Reynolds</h4>
                      <div class="body-text-md text-color-white">CEO, BrightEdge Solutions</div>
                    </div>
                  </div>
                  <div class="testimonial-right-content">
                    <div class="testimonial-icon-block">
                      <div class="w-embed"><svg width="79" height="61" viewBox="0 0 79 61" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <g opacity="0.1">
                            <path d="M78.3676 61H49.4453V33.1604H78.3676V61ZM63.6694 54.1589H49.4453V26.5093C49.4453 18.2747 51.8792 11.8136 56.747 7.12617C61.678 2.37539 68.6004 0 77.5141 0V13.0171C73.2153 13.0171 69.8331 14.1257 67.3676 16.3427C64.9021 18.4964 63.6694 21.8219 63.6694 26.3193V54.1589Z" fill="#676767"></path>
                            <path d="M28.9223 61H0V33.1604H28.9223V61ZM14.2241 54.1589H0V26.5093C0 18.2747 2.4339 11.8136 7.30169 7.12617C12.2327 2.37539 19.1551 0 28.0688 0V13.0171C23.77 13.0171 20.3878 14.1257 17.9223 16.3427C15.4568 18.4964 14.2241 21.8219 14.2241 26.3193V54.1589Z" fill="#676767"></path>
                          </g>
                        </svg>
                      </div>
                    </div>
                    <div class="testimonial-details-wrap">
                      <h3 class="testimonia-title">Outstanding Strategic Business Guidance</h3>
                      <div class="testimonial-line"></div>
                      <p class="body-text-md text-color-gray">Clavix completely transformed how we approach business strategy. Their insights were practical, data-driven, and directly improved our decision-making process. We’ve seen consistent growth since working with them.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="testimonial-arrow is-left w-slider-arrow-left">
              <div class="testimonial-arrow-icon w-embed"><svg width="20" height="17" viewBox="0 0 20 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0.655715 9.90144L6.88926 16.135C7.16818 16.4139 7.6204 16.4139 7.89932 16.135C8.17822 15.8561 8.17824 15.4039 7.89937 15.125L1.81 9.0343L19.2857 9.0343C19.6802 9.0343 20 8.7145 20 8.32001C20 7.92552 19.6802 7.60573 19.2857 7.60573L1.80714 7.60573L7.89918 1.515C8.17814 1.23611 8.17816 0.783874 7.89924 0.504948C7.62036 0.226065 7.1682 0.226041 6.88929 0.504895L0.655715 6.73715C0.232856 7.16001 7.79562e-07 7.72287 7.27359e-07 8.32001C6.75155e-07 8.91716 0.232855 9.48001 0.655715 9.90001L0.655715 9.90144Z" fill="currentColor"></path>
                </svg>
              </div>
            </div>
            <div class="testimonial-arrow is-right w-slider-arrow-right">
              <div class="testimonial-arrow-icon w-embed"><svg width="20" height="17" viewBox="0 0 20 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M19.3443 6.44268L13.1108 0.20913C12.8318 -0.0697894 12.3796 -0.0697896 12.1007 0.20913C11.8218 0.488027 11.8218 0.940202 12.1006 1.21913L18.19 7.30983L0.714287 7.30983C0.319797 7.30983 0 7.62962 0 8.02411C0 8.4186 0.319797 8.7384 0.714287 8.7384L18.1929 8.7384L12.1008 14.8291C11.8219 15.108 11.8219 15.5603 12.1008 15.8392C12.3797 16.1181 12.8318 16.1181 13.1107 15.8392L19.3443 9.60697C19.7672 9.18411 20 8.62126 20 8.02411C20 7.42697 19.7672 6.86411 19.3443 6.44411V6.44268Z" fill="currentColor"></path>
                </svg>
              </div>
            </div>
            <div class="slide-nav w-slider-nav w-round w-num"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
