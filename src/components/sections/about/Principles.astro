---
---
<section class="section-principles">
  <div class="section-gap bottom-none">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="principle-content-wrapper">
        <div scroll="scroll interaction" class="principle-image-block"><img src="/images/approach-Image-5.webp" loading="lazy" sizes="(max-width: 650px) 100vw, 650px" srcset="/images/50e5976346a52773026a366f66c03378_approach-Image-5-p-500.webp 500w, /images/approach-Image-5.webp 650w" alt="principles-image" class="principles-image"></div>
        <div class="principles-content-wrapper">
          <div class="principle-header-block">
            <h2 class="heading-style-2">The Principles That Guide Every Decision I Make</h2>
          </div>
          <div scroll="scroll interaction" class="principle-content-block">
            <div class="principle-content-wrap is-01">
              <div class="principle-top-content">
                <div class="principle-question-block">
                  <div class="principle-question">Integrity</div>
                </div>
                <div class="principle-icon-block is-01">
                  <div class="principle-icon-wrap">
                    <div class="principle-icon"></div>
                    <div class="principle-icon is-01 is-rotate-01"></div>
                  </div>
                </div>
              </div>
              <div class="principle-details-block-two is-01">
                <div class="principle-top-gap-two">
                  <div class="principles-details">
                    <p class="principle-details-text">I believe in honest, transparent guidance even when the truth is uncomfortable. Clear decisions start with real conversations.</p>
                  </div>
                  <div class="principle-details-image-block"><img src="/images/approach-Image-1.webp" loading="lazy" alt="principle-details-image" class="principle-details-image image-hover-scale"></div>
                </div>
              </div>
            </div>
            <div class="principle-content-wrap is-02">
              <div class="principle-top-content">
                <div class="principle-question-block">
                  <div class="principle-question">Clarity Over Complexity</div>
                </div>
                <div class="principle-icon-block is-02">
                  <div class="principle-icon-wrap">
                    <div class="principle-icon"></div>
                    <div class="principle-icon is-01 is-rotate-02"></div>
                  </div>
                </div>
              </div>
              <div class="principle-details-block-two is-02">
                <div class="principle-top-gap-two">
                  <div class="principles-details">
                    <p class="principle-details-text">Complex problems don’t always need complex solutions. I focus on simplifying what matters most so you can move forward with confidence.</p>
                  </div>
                  <div class="principle-details-image-block"><img src="/images/approach-Image-3.webp" loading="lazy" alt="principle-details-image" class="principle-details-image image-hover-scale"></div>
                </div>
              </div>
            </div>
            <div class="principle-content-wrap is-03">
              <div class="principle-top-content">
                <div class="principle-question-block">
                  <div class="principle-question">Responsibility</div>
                </div>
                <div class="principle-icon-block is-03">
                  <div class="principle-icon-wrap">
                    <div class="principle-icon"></div>
                    <div class="principle-icon is-01 is-rotate-03"></div>
                  </div>
                </div>
              </div>
              <div class="principle-details-block-two is-03">
                <div class="principle-top-gap-two">
                  <div class="principles-details">
                    <p class="principle-details-text">You are always in control of your journey. My role is to guide, challenge, and support—not to decide for you.</p>
                  </div>
                  <div class="principle-details-image-block"><img src="/images/approach-Image-2.webp" loading="lazy" alt="principle-details-image" class="principle-details-image image-hover-scale"></div>
                </div>
              </div>
            </div>
            <div class="principle-content-wrap is-04">
              <div class="principle-top-content">
                <div class="principle-question-block">
                  <div class="principle-question">Continuous Growth</div>
                </div>
                <div class="principle-icon-block is-04">
                  <div class="principle-icon-wrap">
                    <div class="principle-icon"></div>
                    <div class="principle-icon is-01 is-rotate-04"></div>
                  </div>
                </div>
              </div>
              <div class="principle-details-block-two is-04">
                <div class="principle-top-gap-two">
                  <div class="principles-details">
                    <p class="principle-details-text">Growth is not a one-time outcome—it’s an ongoing process. I’m committed to learning, refining, and evolving alongside my clients.</p>
                  </div>
                  <div class="principle-details-image-block"><img src="/images/approach-Image-4.webp" loading="lazy" alt="principle-details-image" class="principle-details-image image-hover-scale"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
