---
import VideoLightboxData from '../../global/VideoLightboxData.astro';
---
<section class="section-about-hero">
        <div class="about-section-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div data-wf-target="[[[&quot;6abe84b3182afe641eb8e346&quot;,&quot;924dc571-3ef7-7060-7119-3fa284d4c6ef&quot;],[]]]" class="about-hero-wrapper">
              <div class="about-header-block container-main">
                <div class="about-header">
                  <h1 class="heading-style-h1">Clarity. Strategy. Meaningful Growth</h1>
                </div>
                <div class="about-hero-summary">
                  <p class="body-text-main">I help professionals and individuals navigate important decisions with confidence, structure, and practical guidance.</p>
                </div>
              </div>
              <div class="about-hero-bottom-wrapper">
                <div class="about-hero-image-block"><img src="/images/About-Hero-Image.webp" loading="lazy" sizes="100vw" srcset="/images/7a1742962d7a63fd058fa26ceb91f959_About-Hero-Image-p-500.webp 500w, /images/7a1742962d7a63fd058fa26ceb91f959_About-Hero-Image-p-800.webp 800w, /images/7a1742962d7a63fd058fa26ceb91f959_About-Hero-Image-p-1080.webp 1080w, /images/About-Hero-Image.webp 1400w" alt="about-hero-image" class="about-hero-image"></div>
                <a href="#" class="about-video-icon-block w-inline-block w-lightbox">
                  <div class="about-video-icon w-embed"><svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M7.5241 19.0621C6.85783 19.4721 6 18.9928 6 18.2104V5.78956C6 5.00724 6.85783 4.52789 7.5241 4.93791L17.6161 11.1483C18.2506 11.5388 18.2506 12.4612 17.6161 12.8517L7.5241 19.0621Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                    </svg></div>
                  <div class="body-text-main">Watch Video</div>
                  <VideoLightboxData />
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
