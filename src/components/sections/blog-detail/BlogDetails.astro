---
/** Blog post header (title, date, read time, banner image) and the rich-text body. */
import { formatDate, type Blog } from '../../../lib/cms';

interface Props {
  post: Blog;
}
const { post } = Astro.props;
---
<section class="section-blog-details">
  <div class="blog-details-gap">
    <div class="w-layout-blockcontainer container-fluid w-container">
      <div class="blog-details-wrapper">
        <div data-wf-target="[[[&quot;6abe84b3182afe641eb8e34c&quot;,&quot;c4d16cdb-0c25-e9e2-c09e-dccb24040502&quot;],[]]]" class="blog-details-content-block">
          <div class="blog-details-header-block">
            <div class="section-header-block max-width-42-313rem">
              <h1 class="blog-details-title">{post.title}</h1>
            </div>
            <div class="blog-details-text-block">
              <div class="blog-details-text-wrap">
                <div class="blog-details-icon w-embed"><svg width="20" height="20" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M15 1.66667V3.33334M5 1.66667V3.33334" stroke="#5A5A5A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M9.9961 10.8333H10.0036M9.9961 14.1667H10.0036M13.3257 10.8333H13.3332M6.6665 10.8333H6.67398M6.6665 14.1667H6.67398" stroke="#5A5A5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M2.9165 6.66667H17.0832" stroke="#5A5A5A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M2.0835 10.2027C2.0835 6.57161 2.0835 4.75607 3.12693 3.62803C4.17036 2.5 5.84974 2.5 9.2085 2.5H10.7918C14.1506 2.5 15.83 2.5 16.8734 3.62803C17.9168 4.75607 17.9168 6.57161 17.9168 10.2027V10.6306C17.9168 14.2617 17.9168 16.0773 16.8734 17.2053C15.83 18.3333 14.1506 18.3333 10.7918 18.3333H9.2085C5.84974 18.3333 4.17036 18.3333 3.12693 17.2053C2.0835 16.0773 2.0835 14.2617 2.0835 10.6306V10.2027Z" stroke="#5A5A5A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M2.5 6.66667H17.5" stroke="#5A5A5A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
                <div class="body-text-main">{formatDate(post.date)}</div>
              </div>
              <div class="blog-details-text-wrap">
                <div class="blog-details-icon w-embed"><svg width="20" height="20" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10.0003 18.3333C14.6027 18.3333 18.3337 14.6024 18.3337 10C18.3337 5.39763 14.6027 1.66667 10.0003 1.66667C5.39795 1.66667 1.66699 5.39763 1.66699 10C1.66699 14.6024 5.39795 18.3333 10.0003 18.3333Z" stroke="#5A5A5A" stroke-width="1.5"></path>
                    <path d="M10.0068 8.75682C9.31648 8.75682 8.75684 9.31646 8.75684 10.0068C8.75684 10.6972 9.31648 11.2568 10.0068 11.2568C10.6972 11.2568 11.2568 10.6972 11.2568 10.0068C11.2568 9.31646 10.6972 8.75682 10.0068 8.75682ZM10.0068 8.75682V5.83252M12.5126 12.5165L10.8887 10.8927" stroke="#5A5A5A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
                <div class="body-text-main">{post.readTime}</div>
              </div>
            </div>
          </div>
          <div class="blog-details-image-block">{post.bannerImage && <img src={post.bannerImage.url} loading="eager" fetchpriority="high" alt={post.bannerImage.alt} class="blog-details-image" />}</div>
        </div>
        <div class="blog-details-content-wrapper">
          <div scroll="scroll interaction" class="blog-details-text w-richtext" set:html={post.content} />
        </div>
      </div>
    </div>
  </div>
</section>
