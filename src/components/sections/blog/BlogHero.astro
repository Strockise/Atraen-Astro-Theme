---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section-blog-hero">
  <div class="w-layout-blockcontainer container-main w-container">
    <div class="blog-hero-wrapper">
      <div class="blog-hero-header-block">
        <div page-load-0="" class="section-title-block">
          <SectionTitle text="OUR JOURNAL" variant="light" />
        </div>
        <div class="section-header-block">
          <h1 heading-title="" class="heading-style-1 text-color-white">Insights, Strategies and Business Perspectives</h1>
        </div>
      </div>
      <div class="blog-hero-counter-wrapper">
        <div page-load-1="" class="blog-counter-single-card is-border-left">
          <h2 class="counter-number text-color-white">120+</h2>
          <p class="body-text-md text-color-white">Published Articles</p>
        </div>
        <div page-load-2="" class="blog-counter-single-card is-border-left">
          <h3 class="counter-number text-color-white">50K+</h3>
          <p class="body-text-md text-color-white">Monthly Readers</p>
        </div>
      </div>
    </div>
    <div class="blog-hero-image-block"><img src="/images/Blog-Hero-Image.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="/images/Blog-Hero-Image-p-500.webp 500w, /images/Blog-Hero-Image-p-800.webp 800w, /images/Blog-Hero-Image-p-1080.webp 1080w, /images/Blog-Hero-Image-p-1600.webp 1600w, /images/Blog-Hero-Image-p-2000.webp 2000w, /images/Blog-Hero-Image-p-2600.webp 2600w, /images/Blog-Hero-Image.webp 2880w" alt="blog-hero-image" class="blog-hero-image"></div>
    <div class="blog-overlay"></div>
  </div>
</section>
