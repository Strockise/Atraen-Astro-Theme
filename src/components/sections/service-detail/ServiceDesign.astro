                </svg>
              </div>
            </div>
            <div class="service-design-card-details">
              <div class="service-details w-richtext" set:html={service.audience[2] ?? ''} />
            </div>
          </div>
          <div class="service-design-single-card">
            <div class="service-design-icon-block">
              <div class="service-design-icon w-embed"><svg width="20" height="20" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
