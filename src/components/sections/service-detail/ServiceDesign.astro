---
/** 'Who this service is designed for': four rich-text cards (audienceOne…Four). */
import type { Service } from '../../../lib/cms';

interface Props {
  service: Service;
}
const { service } = Astro.props;
---
<section class="service-design-section">
  <div class="section-design-bg-color">
    <div class="w-layout-blockcontainer container-main w-container">
      <div scroll="scroll interaction" class="service-design-wrapper">
        <div scroll="scroll interaction" class="service-header-block-two">
          <div class="section-header-block max-width-23rem">
            <h2 class="heading-style-2">Who This Service Is Designed For</h2>
          </div>
          <div class="section-summary-block max-width22-81rem">
            <p class="body-text-base">This consulting service is ideal for individuals seeking clarity, direction, and confident decision-making in both personal and professional life.</p>
          </div>
        </div>
        <div class="service-design-line"></div>
        <div scroll="scroll interaction" class="service-design-content-block">
          <div class="service-design-single-card">
            <div class="service-design-icon-block">
              <div class="service-design-icon w-embed"><svg width="20" height="20" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
