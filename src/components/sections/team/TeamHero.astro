---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_team-hero">
  <div class="w-layout-blockcontainer container-main w-container">
    <div class="team-hero-wrapper">
      <div class="team-hero-header-block">
        <div page-load-0="" class="section-title-block">
          <SectionTitle text="OUR MEMBERS" variant="light" />
        </div>
        <div class="section-header-block">
          <h1 heading-title="" class="heading-style-1 text-color-white">Meet the Experts Behind Clavix Success</h1>
        </div>
      </div>
      <div class="team-hero-counter-wrapper">
        <div page-load-1="" class="team-counter-single-card is-border-left">
          <h2 class="counter-number text-color-white">25+</h2>
          <p class="body-text-md text-color-white">Industry Experts</p>
        </div>
        <div page-load-2="" class="team-counter-single-card is-border-left">
          <h3 class="counter-number text-color-white">10+</h3>
          <p class="body-text-md text-color-white">Years Combined Experience</p>
        </div>
      </div>
    </div>
    <div class="team-hero-image-block"><img src="/images/Team-Image.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="/images/3f531b44160cf7df933b864a77a2eded_Team-Image-p-500.webp 500w, /images/3f531b44160cf7df933b864a77a2eded_Team-Image-p-800.webp 800w, /images/3f531b44160cf7df933b864a77a2eded_Team-Image-p-1080.webp 1080w, /images/3f531b44160cf7df933b864a77a2eded_Team-Image-p-1600.webp 1600w, /images/Team-Image.webp 1920w" alt="team-hero-image" class="team-hero-image"></div>
    <div class="team-overlay"></div>
  </div>
</section>
