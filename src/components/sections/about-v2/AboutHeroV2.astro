---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_about-hero-v2">
  <div class="about-hero-bg-image">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="about-hero-wrapper-v2">
        <div class="about-hero-header-block">
          <div page-load-0="" class="section-title-block">
            <SectionTitle text="ABOUT US" variant="light" />
          </div>
          <div class="section-header-block">
            <h1 heading-title="" class="heading-style-1 text-color-white">Your Trusted Partner in Business Success</h1>
          </div>
        </div>
        <div class="about-hero-counter-wrapper">
          <div page-load-1="" class="about-counter-single-card is-border-left">
            <h2 class="counter-number text-color-white counter-anim">15+</h2>
            <p class="body-text-md text-color-white">Years of Industry Experience</p>
          </div>
          <div page-load-2="" class="about-counter-single-card is-border-left">
            <h3 class="counter-number text-color-white counter-anim">500+</h3>
            <p class="body-text-md text-color-white">Successful Projects Delivered</p>
          </div>
        </div>
      </div>
      <div class="about-hero-gradient"></div>
    </div>
  </div>
</section>
