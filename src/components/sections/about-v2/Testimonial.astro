              <div class="testimonial-slider w-slide">
                <div class="testimonial-card-content-block">
                  <div class="testimonial-card-content">
                    <div class="testimonial-card-details">
                      <div class="testimonial-card-icon-block">
                        <div class="testimonial-card-icon w-embed"><svg width="94" height="73" viewBox="0 0 94 73" fill="none" xmlns="http://www.w3.org/2000/svg">
