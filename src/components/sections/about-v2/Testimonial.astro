---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_testimonial">
  <div class="testimonial-bg-color">
    <div class="w-layout-blockcontainer container-small w-container">
      <div class="testimonial-wrapper">
        <div class="testimonial-top-wrapper is-testimonial">
          <div page-scroll-0="" class="section-title-block is-gap-none">
            <SectionTitle text="TESTIMONIAL" />
          </div>
          <div class="section-header-block">
            <h2 title-scroll="" class="heading-style-2">What Our Clients Say About Clavix</h2>
          </div>
        </div>
        <div page-scroll-2="" class="testimonial-content-wrapper-v4">
          <div data-delay="4000" data-animation="slide" class="testimonial-slider-block is-center w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
