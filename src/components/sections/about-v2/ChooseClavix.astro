---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_choose-clavix">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="choose-clavix-wrapper">
        <div class="choose-clavix-header-block">
          <div page-scroll-0="" class="section-title-block">
            <SectionTitle text="WHY CHOOSE CLAVIX" />
          </div>
          <div class="section-header-block">
            <h2 title-scroll="" class="heading-style-2">Discover our simple three-step process for smarter business transformation</h2>
          </div>
        </div>
        <div class="choose-clavix-right-content">
          <div page-scroll-1="" class="choose-clavix-image-block"><img src="/images/Choose-Clavix-Image.webp" loading="lazy" sizes="100vw" srcset="/images/Choose-Clavix-Image-p-500.webp 500w, /images/Choose-Clavix-Image-p-800.webp 800w, /images/Choose-Clavix-Image.webp 945w" alt="choose-clavix-image" class="choose-clavix-image"></div>
          <div page-scroll-2="" class="choose-clavix-content-wrap">
            <p class="body-text-large is-heading-font">At Clavix, we believe that every successful business is built on a strong foundation of strategy, innovation, and informed decision-making. Our team works closely with organizations to identify opportunities, overcome challenges, and create sustainable paths to growth.</p>
            <p class="body-text-large is-heading-font">With a client-focused approach, we deliver tailored consulting solutions designed to address unique business needs and objectives.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
