---
import PrimaryButton from '../../ui/PrimaryButton.astro';
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_about-hero">
  <div class="section-about-bg-color">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="about-hero-wrapper is-text-alight-left">
        <div class="about-hero-header-block">
          <div page-load-0="" class="section-title-block">
            <SectionTitle text="ABOUT US" variant="light" />
          </div>
          <div class="section-header-block">
            <h1 heading-title="" class="heading-style-1 text-color-white">Your Trusted Partner in Business Success</h1>
          </div>
          <div page-load-1="" class="about-hero-button-block">
            <PrimaryButton href="/contact/contact-v1" text="Free Consultation" variant="accent" />
          </div>
        </div>
        <div page-load-2="" class="about-hero-image-block"><img src="/images/About-Hero-Image.webp" loading="lazy" sizes="100vw" srcset="/images/About-Hero-Image-p-500.webp 500w, /images/About-Hero-Image-p-800.webp 800w, /images/About-Hero-Image-p-1080.webp 1080w, /images/About-Hero-Image-p-1600.webp 1600w, /images/About-Hero-Image.webp 1935w" alt="about-hero-image-large" class="about-hero-image-large"></div>
      </div>
    </div>
  </div>
</section>
