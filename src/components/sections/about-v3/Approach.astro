---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_approach">
  <div class="section-bg-color">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="approach-wrapper is-horizontal">
        <div page-scroll-0="" class="section-title-block">
          <SectionTitle text="OUR APPROACH" />
        </div>
        <div class="approach-content-wrapper">
          <div class="section-header-block">
            <h2 title-scroll="" class="heading-style-2">Exceptional consulting support — clear insights, actionable strategies,  and measurable results that strengthened our business performance.</h2>
          </div>
          <div page-scroll-2="" class="approach-counter-wrapper">
            <div class="about-counter-wrapper w-variant-5e4a6014-9a45-2926-90a8-9df03060a721">
              <div class="about-counter-single-card w-variant-5e4a6014-9a45-2926-90a8-9df03060a721">
                <h3 class="counter-number w-variant-5e4a6014-9a45-2926-90a8-9df03060a721 counter-anim">15+</h3>
                <p class="body-text-md text-color-gray">Years of Industry Experience</p>
              </div>
              <div class="about-counter-single-card w-variant-5e4a6014-9a45-2926-90a8-9df03060a721">
                <h3 class="counter-number w-variant-5e4a6014-9a45-2926-90a8-9df03060a721 counter-anim">500+</h3>
                <p class="body-text-md text-color-gray">Successful Projects Delivered</p>
              </div>
              <div class="about-counter-single-card w-variant-5e4a6014-9a45-2926-90a8-9df03060a721">
                <h3 class="counter-number w-variant-5e4a6014-9a45-2926-90a8-9df03060a721 counter-anim">120M+</h3>
                <p class="body-text-md text-color-gray">Revenue Growth Supported</p>
              </div>
              <div class="about-counter-single-card w-variant-5e4a6014-9a45-2926-90a8-9df03060a721">
                <h3 class="counter-number w-variant-5e4a6014-9a45-2926-90a8-9df03060a721 counter-anim">98%</h3>
                <p class="body-text-md text-color-gray">Client Satisfaction Rate</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
