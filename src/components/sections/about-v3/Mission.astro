---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_mission">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="mission-wrapper-v3">
        <div class="mission-top-wrapper">
          <div page-scroll-0="" class="section-title-block">
            <SectionTitle text="OUR MISSION" />
          </div>
          <div class="section-header-block max-width-51">
            <h2 page-scroll-1="" class="heading-style-2 about-header">Our mission is to help organizations overcome challenges, unlock opportunities, and achieve long-term success through strategic consulting.</h2>
          </div>
        </div>
        <div class="mission-content-grid">
          <div class="mission-single-card">
            <div class="mission-image-wrap-v3">
              <div class="mission-image-wrap"><img src="/images/Mission-Image-1.webp" loading="lazy" alt="mission-image" class="mission-image"></div>
            </div>
            <div class="mission-summary-block">
              <p class="body-text-sm">We help businesses overcome challenges with clear and effective strategies.</p>
            </div>
          </div>
          <div page-scroll-2="" class="mission-single-card">
            <div class="mission-image-wrap-v3"><img src="/images/About-Image-1-2.webp" loading="lazy" alt="mission-image" class="mission-image"></div>
          </div>
          <div page-scroll-3="" class="mission-single-card">
            <div class="mission-image-wrap-v3">
              <div class="mission-image-wrap"><img src="/images/Mission-Image-2.webp" loading="lazy" alt="mission-image" class="mission-image"></div>
            </div>
            <div class="mission-summary-block">
              <p class="body-text-sm">Our focus is to drive sustainable growth through practical consulting solutions.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
