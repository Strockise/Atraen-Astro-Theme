---
import PrimaryButton from '../../ui/PrimaryButton.astro';
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_play-video">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-full w-container">
      <div class="play-video-wrapper">
        <div class="play-video-top">
          <div class="play-video-header-block">
            <div page-scroll-0="" class="section-title-block">
              <SectionTitle text="WHO WE ARE" />
            </div>
            <div class="section-header-block">
              <h2 title-scroll="">Dedicated to Driving Business Success Through Strategic Excellence</h2>
            </div>
          </div>
          <div page-scroll-2="" class="play-video-button">
            <PrimaryButton href="/contact/contact-v1" text="Book a Consultation" variant="light" />
          </div>
        </div>
        <div class="play-vide-bottom-wrapper">
          <div class="play-video-sticky-container">
            <div class="play-video-sticky-block">
              <div class="video-wrapper">
                <div class="video-block">
                  <div data-poster-url="/videos/8425716-hd_1920_1080_25fps_poster.0000000.jpg" data-video-urls="/videos/8425716-hd_1920_1080_25fps_mp4.mp4,/videos/8425716-hd_1920_1080_25fps_webm.webm" data-autoplay="true" data-loop="true" class="video w-background-video w-background-video-atom"><video autoplay loop muted playsinline poster="/videos/8425716-hd_1920_1080_25fps_poster.0000000.jpg" id="bg-video-8425716-3">
                      <source src="/videos/8425716-hd_1920_1080_25fps_mp4.mp4">
                      <source src="/videos/8425716-hd_1920_1080_25fps_webm.webm">
                    </video>
                    <div aria-live="polite"><button type="button" aria-controls="bg-video-8425716-3" class="w-backgroundvideo-backgroundvideoplaypausebutton play-vice-icon-block w-background-video--control" data-video-toggle aria-label="Pause video"><span>
                          <div class="play-video-text">Pause Video</div>
                        </span><span hidden="">
                          <div class="play-video-text">Play Video</div>
                        </span></button></div>
                  <img data-wf-bgvideo-fallback-img="true" src="/videos/8425716-hd_1920_1080_25fps_poster.0000000.jpg" alt=""></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
