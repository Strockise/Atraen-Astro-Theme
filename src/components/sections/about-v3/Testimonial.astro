---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_testimonial">
  <div class="section-gap top-none">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="testimonial-wrapper text-align-left">
        <div class="testimonial-header-block text-align-left">
          <div page-scroll-0="" class="section-title-block">
            <SectionTitle text="OUR EXPERTISE" />
          </div>
          <div class="section-header-block">
            <h2 title-scroll="">Meet the Experts Behind Clavix Success</h2>
          </div>
        </div>
        <div page-scroll-2="" class="testimonial-content-wrapper width-full">
          <div data-delay="4000" data-animation="slide" class="testimonial-slider-block is-mobile w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
            <div class="testimonial-slider-mask is-block w-slider-mask">
              <div class="testimonial-slider w-slide">
                <div class="testimonial-content-card">
                  <div class="testimonial-avaar-wrapper">
                    <div class="testimonial-avatar-block-v2 top-none">
                      <div class="testimonial-avatar-image-block"><img src="/images/Testimonial-Avatar-Image_1Testimonial-Avatar-Image.png" loading="lazy" alt="testimonial-avatar-image" class="testimonial-avatar-image"></div>
                      <div class="testimonial-avatar-details">
                        <div class="heading-style-4 is-mobile">Michael Reynolds</div>
                        <div class="body-text-sm is-mobile">CEO, BrightEdge Solutions</div>
                      </div>
                    </div>
                    <div class="testimonial-icon-block">
                      <div class="w-embed"><svg width="79" height="61" viewBox="0 0 79 61" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <g opacity="0.1">
                            <path d="M78.3676 61H49.4453V33.1604H78.3676V61ZM63.6694 54.1589H49.4453V26.5093C49.4453 18.2747 51.8792 11.8136 56.747 7.12617C61.678 2.37539 68.6004 0 77.5141 0V13.0171C73.2153 13.0171 69.8331 14.1257 67.3676 16.3427C64.9021 18.4964 63.6694 21.8219 63.6694 26.3193V54.1589Z" fill="#676767"></path>
