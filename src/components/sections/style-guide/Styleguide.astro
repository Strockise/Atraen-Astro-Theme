---
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<section class="section-styleguide">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="styleguide-wrapper">
        <div class="styleguide-header-block">
          <div class="section-header-block">
            <div heading-title="" class="heading-style-1">Style Guide</div>
          </div>
          <div page-load-1="" class="section-summary-block-2">
            <p class="body-text-main">Explore the visual foundation behind this template</p>
          </div>
        </div>
        <div page-load-2="" class="styleguide-content-block">
          <div class="styleguide-content-wrapper">
            <div class="styleyguide-title-block">
              <div class="styleguide-title">Color Palette</div>
            </div>
            <div class="styleguide-color-grid">
              <div class="styleguide-color-card">
                <div class="styleguide-color-block is-01"></div>
                <div class="styleguide-color-content-block">
                  <div class="body-text-main text-color-black">Primary</div>
                  <div class="body-text-base">#4E6E40</div>
                </div>
              </div>
              <div class="styleguide-color-card">
                <div class="styleguide-color-block is-02"></div>
                <div class="styleguide-color-content-block">
                  <div class="body-text-main text-color-black">Secondary</div>
                  <div class="body-text-base">#F0F3EE</div>
                </div>
              </div>
              <div class="styleguide-color-card">
                <div class="styleguide-color-block is-03"></div>
                <div class="styleguide-color-content-block">
                  <div class="body-text-main text-color-black">Gray</div>
                  <div class="body-text-base">#676767</div>
                </div>
              </div>
              <div class="styleguide-color-card">
                <div class="styleguide-color-block is-04"></div>
                <div class="styleguide-color-content-block">
                  <div class="body-text-main text-color-black">Black</div>
                  <div class="body-text-base">#141414</div>
                </div>
              </div>
              <div class="styleguide-color-card">
                <div class="styleguide-color-block is-05"></div>
                <div class="styleguide-color-content-block">
                  <div class="body-text-main text-color-black">White</div>
                  <div class="body-text-base">#FFFFFF</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="styleguide-content-block">
          <div scroll="scroll interaction" class="styleguide-content-wrapper">
            <div class="styleyguide-title-block">
              <div class="styleguide-title">Typography</div>
            </div>
            <div scroll="scroll interaction" class="styleguide-typography-block">
              <div class="styleguide-typography-wrapper">
                <h1 class="heading-style-h1">Heading 1</h1>
                <p class="body-text-base">Open Sauce One • 4 Rem • 1.2 Line Height</p>
              </div>
              <div class="styleguide-typography-wrapper">
                <h2 class="heading-style-2">Heading 2</h2>
                <p class="body-text-base">Open Sauce One • 2.75 Rem • 1.2 Line Height</p>
              </div>
              <div class="styleguide-typography-wrapper">
                <h3 class="heading-style-3 text-color-black">Heading 3</h3>
                <p class="body-text-base">Open Sauce One • 1.5 Rem • 1.2 Line Height</p>
              </div>
              <div class="styleguide-typography-wrapper">
                <h4 class="heading-style-4">Heading 4</h4>
                <p class="body-text-base">Open Sauce One • 1.25 Rem • 1.2 Line Height</p>
              </div>
              <div class="styleguide-typography-wrapper">
                <h5 class="heading-style-5">Heading 5</h5>
                <p class="body-text-base">Open Sauce One • 1.125 Rem • 1.2 Line Height</p>
              </div>
              <div class="styleguide-typography-wrapper">
                <h6 class="heading-style-6">Heading 6</h6>
                <p class="body-text-base">Open Sauce One • 1.125 Rem • 1.2 Line Height</p>
              </div>
              <div class="styleguide-typography-wrapper">
                <p class="bodyt-text-large">Body 1</p>
                <p class="body-text-base">Inter • 1.25 Rem • 1.3 Line Height</p>
              </div>
              <div class="styleguide-typography-wrapper">
                <div class="body-text-main">Body 2</div>
                <p class="body-text-base">Inter • 1.125 Rem • 1.3 Line Height</p>
              </div>
              <div class="styleguide-typography-wrapper">
                <div class="body-text-base">Body 3</div>
                <p class="body-text-base">Inter • 0.875 Rem • 1.3 Line Height</p>
              </div>
              <div class="styleguide-typography-wrapper">
                <div class="body-text-small">Body 4</div>
                <p class="body-text-base">Inter • 0.75 Rem • 1.3 Line Height</p>
              </div>
            </div>
          </div>
        </div>
        <div class="styleguide-content-block">
          <div scroll="scroll interaction" class="styleguide-content-wrapper">
            <div class="styleyguide-title-block">
              <div title-scroll="" class="styleguide-title">Button</div>
            </div>
            <div class="styleguide-typography-block">
              <div class="styleguidxe-button-block">
                <PrimaryButton href="/contact/contact-v1" text="Free Consultation" />
                <PrimaryButton href="/contact/contact-v1" text="Free Consultation" variant="light" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
