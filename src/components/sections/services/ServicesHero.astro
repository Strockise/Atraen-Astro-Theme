---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section-services-hero">
  <div class="w-layout-blockcontainer container-main w-container">
    <div class="service-hero-wrapper">
      <div class="services-hero-header-block is-max-width">
        <div page-load-0="" class="section-title-block">
          <SectionTitle text="SERVICES" variant="light" />
        </div>
        <div class="section-header-block">
          <h1 heading-title="" class="heading-style-1 text-color-white">Delivering Strategic Solutions That Drive Growth</h1>
        </div>
      </div>
      <div class="services-hero-counter-wrapper">
        <div page-load-1="" class="blog-counter-single-card is-border-left">
          <h2 class="counter-number text-color-white">120+</h2>
          <p class="body-text-md text-color-white">Years of Industry Experience</p>
        </div>
        <div page-load-2="" class="blog-counter-single-card is-border-left">
          <h3 class="counter-number text-color-white">50K+</h3>
          <p class="body-text-md text-color-white">Successful Projects Delivered</p>
        </div>
      </div>
    </div>
    <div class="service-hero-image-block"><img src="/images/Services-Image.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="/images/bd113e8fb05d03e031983be87967142e_Services-Image-p-500.webp 500w, /images/bd113e8fb05d03e031983be87967142e_Services-Image-p-800.webp 800w, /images/bd113e8fb05d03e031983be87967142e_Services-Image-p-1080.webp 1080w, /images/bd113e8fb05d03e031983be87967142e_Services-Image-p-1600.webp 1600w, /images/bd113e8fb05d03e031983be87967142e_Services-Image-p-2000.webp 2000w, /images/bd113e8fb05d03e031983be87967142e_Services-Image-p-2600.webp 2600w, /images/bd113e8fb05d03e031983be87967142e_Services-Image-p-3200.webp 3200w, /images/Services-Image.webp 3840w" alt="services-hero-image" class="services-hero-image"></div>
    <div class="service-overlay"></div>
  </div>
</section>
