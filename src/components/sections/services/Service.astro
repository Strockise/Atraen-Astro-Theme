---
import SectionTitle from '../../ui/SectionTitle.astro';
import ServiceRowCard from '../../cards/ServiceRowCard.astro';
import ServiceRowCardAlt from '../../cards/ServiceRowCardAlt.astro';
import ServiceRowCardAlt2 from '../../cards/ServiceRowCardAlt2.astro';
import ServiceRowCardSlide from '../../cards/ServiceRowCardSlide.astro';
import ServiceRowCardSlideAlt from '../../cards/ServiceRowCardSlideAlt.astro';
import ServiceRowCardSlideAlt2 from '../../cards/ServiceRowCardSlideAlt2.astro';
import { getServices, take } from '../../../lib/cms';

const services = await getServices();
---
<section class="section_service">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="service-wrapper">
        <div class="service-header-blcok">
          <div page-scroll-0="" class="section-title-block">
            <SectionTitle text="OUR SERVICES" />
          </div>
          <div class="section-header-block">
            <h2 title-scroll="" class="heading-style-2">Consulting Services Designed to Accelerate Business Growth</h2>
          </div>
        </div>
        <div class="service-content-wrapper-two desktop">
          <div class="service-cms-list-wrapper w-dyn-list">
            <div role="list" class="service-cms-list w-dyn-items">{take(services, 1).map((entry) => (<div role="listitem" class="service-cms-item w-dyn-item"><ServiceRowCard item={entry} /></div>))}</div>
            {take(services, 1).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
          </div>
          <div class="service-cms-list-wrapper w-dyn-list">
            <div role="list" class="service-cms-list w-dyn-items">{take(services, 1, 1).map((entry) => (<div role="listitem" class="service-cms-item w-dyn-item"><ServiceRowCardAlt item={entry} /></div>))}</div>
            {take(services, 1, 1).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
          </div>
          <div class="service-cms-list-wrapper w-dyn-list">
            <div role="list" class="service-cms-list w-dyn-items">{take(services, 1, 2).map((entry) => (<div role="listitem" class="service-cms-item w-dyn-item"><ServiceRowCardAlt2 item={entry} /></div>))}</div>
            {take(services, 1, 2).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
          </div>
          <div class="service-cms-list-wrapper w-dyn-list">
            <div role="list" class="service-cms-list w-dyn-items">{take(services, 1, 3).map((entry) => (<div role="listitem" class="service-cms-item w-dyn-item"><ServiceRowCardAlt item={entry} /></div>))}</div>
            {take(services, 1, 3).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
          </div>
          <div class="service-cms-list-wrapper w-dyn-list">
            <div role="list" class="service-cms-list w-dyn-items">{take(services, 1, 4).map((entry) => (<div role="listitem" class="service-cms-item w-dyn-item"><ServiceRowCardAlt2 item={entry} /></div>))}</div>
            {take(services, 1, 4).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
          </div>
        </div>
        <div class="service-content-wrapper-two mobile">
          <div data-delay="4000" data-animation="slide" class="slider-block w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
            <div class="slider-mask w-slider-mask">
              <div class="slider w-slide">
                <div class="service-cms-list-wrapper w-dyn-list">
                  <div role="list" class="service-cms-list w-dyn-items">{take(services, 1).map((entry) => (<div role="listitem" class="service-cms-item w-dyn-item"><ServiceRowCardSlide item={entry} /></div>))}</div>
                  {take(services, 1).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
                </div>
              </div>
              <div class="slider w-slide">
                <div class="service-cms-list-wrapper w-dyn-list">
                  <div role="list" class="service-cms-list w-dyn-items">{take(services, 1, 1).map((entry) => (<div role="listitem" class="service-cms-item w-dyn-item"><ServiceRowCardSlideAlt item={entry} /></div>))}</div>
                  {take(services, 1, 1).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
                </div>
              </div>
              <div class="slider w-slide">
                <div class="service-cms-list-wrapper w-dyn-list">
                  <div role="list" class="service-cms-list w-dyn-items">{take(services, 1, 2).map((entry) => (<div role="listitem" class="service-cms-item w-dyn-item"><ServiceRowCardSlideAlt2 item={entry} /></div>))}</div>
                  {take(services, 1, 2).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
                </div>
              </div>
              <div class="slider w-slide">
                <div class="service-cms-list-wrapper w-dyn-list">
                  <div role="list" class="service-cms-list w-dyn-items">{take(services, 1, 3).map((entry) => (<div role="listitem" class="service-cms-item w-dyn-item"><ServiceRowCardSlideAlt item={entry} /></div>))}</div>
                  {take(services, 1, 3).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
                </div>
              </div>
              <div class="slider w-slide">
                <div class="service-cms-list-wrapper w-dyn-list">
                  <div role="list" class="service-cms-list w-dyn-items">{take(services, 1, 4).map((entry) => (<div role="listitem" class="service-cms-item w-dyn-item"><ServiceRowCardSlideAlt2 item={entry} /></div>))}</div>
                  {take(services, 1, 4).length === 0 && (<div class="w-dyn-empty">
  <div>No items found.</div>
</div>)}
                </div>
              </div>
            </div>
            <div class="slider-arrow is-left w-slider-arrow-left">
              <div class="slider-arrow-icon w-embed"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6.41699 14.0029H22.167" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M12.8339 21.003C12.8339 21.003 5.834 15.8475 5.83398 14.0029C5.83397 12.1583 12.834 7.00293 12.834 7.00293" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
            </div>
            <div class="slider-arrow is-right w-slider-arrow-right">
              <div class="slider-arrow-icon w-embed"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M21.584 13.9971L5.83398 13.9971" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M15.1661 6.99701C15.1661 6.99701 22.166 12.1525 22.166 13.9971C22.166 15.8417 15.166 20.9971 15.166 20.9971" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
            </div>
            <div class="slide-nav w-slider-nav w-round w-num"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
