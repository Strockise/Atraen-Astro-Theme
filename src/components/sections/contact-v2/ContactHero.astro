---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_contact-hero">
  <div class="w-layout-blockcontainer container-main w-container">
    <div class="contact-hero-wrapper">
      <div class="contact-hero-header-block">
        <div page-load-0="" class="section-title-block">
          <SectionTitle text="CONTACT US" variant="light" />
        </div>
        <div class="section-header-block">
          <h1 heading-title="" class="heading-style-1 text-color-white">Let&#x27;s Start Building Your Next Growth Strategy</h1>
        </div>
      </div>
      <div class="contact-hero-counter-wrapper">
        <div page-load-1="" class="contact-counter-single-card is-border-left">
          <h2 class="counter-number text-color-white counter-anim">150+</h2>
          <p class="body-text-md text-color-white">Businesses Advised</p>
        </div>
        <div page-load-2="" class="contact-counter-single-card is-border-left">
          <h2 class="counter-number text-color-white counter-anim">98%</h2>
          <p class="body-text-md text-color-white">Client Satisfaction Rate</p>
        </div>
      </div>
    </div>
    <div class="contact-hero-image-block"><img src="/images/Blog-Hero-Image.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="/images/Blog-Hero-Image-p-500.webp 500w, /images/Blog-Hero-Image-p-800.webp 800w, /images/Blog-Hero-Image-p-1080.webp 1080w, /images/Blog-Hero-Image-p-1600.webp 1600w, /images/Blog-Hero-Image-p-2000.webp 2000w, /images/Blog-Hero-Image-p-2600.webp 2600w, /images/Blog-Hero-Image.webp 2880w" alt="contact-hero-image" class="contact-hero-image"></div>
    <div class="contact-overlay"></div>
  </div>
</section>
