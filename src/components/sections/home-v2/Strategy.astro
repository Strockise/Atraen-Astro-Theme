---
import SectionTitle from '../../ui/SectionTitle.astro';
---
<section class="section_strategy">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="strategy-wrapper">
        <div class="strategy-header-block">
          <div page-scroll-0="" class="strategy-title-block">
            <SectionTitle text="INNOVATION STRATEGY" />
          </div>
          <div class="section-header-block">
            <h2 title-scroll="" class="heading-style-2">Navigate The Complex Simplify The Future Consult With Us</h2>
          </div>
        </div>
        <div page-scroll-2="" class="strategy-image-wrapper">
          <div data-poster-url="/videos/8124295-hd_1920_1080_30fps_poster.0000000.jpg" data-video-urls="/videos/8124295-hd_1920_1080_30fps_mp4.mp4,/videos/8124295-hd_1920_1080_30fps_webm.webm" data-autoplay="true" data-loop="true" class="strategy-video w-background-video w-background-video-atom"><video autoplay loop muted playsinline poster="/videos/8124295-hd_1920_1080_30fps_poster.0000000.jpg" id="bg-video-8124295-1">
              <source src="/videos/8124295-hd_1920_1080_30fps_mp4.mp4">
              <source src="/videos/8124295-hd_1920_1080_30fps_webm.webm">
            </video>
            <div aria-live="polite"><button type="button" aria-controls="bg-video-8124295-1" class="w-backgroundvideo-backgroundvideoplaypausebutton video-control-button w-background-video--control" data-video-toggle aria-label="Pause video"><span class="video-control-icon"><img src="/images/video-pause.svg" loading="lazy" alt="Pause video"></span><span hidden=""><img loading="lazy" alt="Play video" src="/images/video-play.svg"></span></button></div>
          <img data-wf-bgvideo-fallback-img="true" src="/videos/8124295-hd_1920_1080_30fps_poster.0000000.jpg" alt=""></div>
        </div>
        <div page-scroll-3="" class="strategy-counter-wrapper">
          <div class="about-counter-wrapper">
            <div class="about-counter-single-card w-variant-4c0719cf-0a15-157c-698e-7b16b201fa88">
              <h3 class="counter-number counter-anim">15+</h3>
              <p class="body-text-md text-color-gray">Years of Industry Experience</p>
            </div>
            <div class="about-counter-single-card w-variant-4c0719cf-0a15-157c-698e-7b16b201fa88">
              <h3 class="counter-number counter-anim">500+</h3>
              <p class="body-text-md text-color-gray">Successful Projects Delivered</p>
            </div>
            <div class="about-counter-single-card w-variant-4c0719cf-0a15-157c-698e-7b16b201fa88">
              <h3 class="counter-number counter-anim">120M+</h3>
              <p class="body-text-md text-color-gray">Revenue Growth Supported</p>
            </div>
            <div class="about-counter-single-card w-variant-4c0719cf-0a15-157c-698e-7b16b201fa88">
              <h3 class="counter-number counter-anim">98%</h3>
              <p class="body-text-md text-color-gray">Client Satisfaction Rate</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
