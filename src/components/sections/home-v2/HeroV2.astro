---
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<section class="section_hero-v2">
  <div class="section-hero-bg-color">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="hero-wrapper-v2">
        <div class="hero-content-wrapper">
          <div page-load-0="" class="hero-title-block-v2">
            <div class="body-text-sm text-color-white font-weight-medium">GROWTH-FOCUSED CONSULTING</div>
          </div>
          <div class="section-header-block is-gap-v2">
            <h1 heading-title="" class="heading-style-1 text-color-white">Helping Visionary Businesses Grow Beyond Limits</h1>
          </div>
          <div page-load-1="" class="section-summary-block max-width-47">
            <p class="body-text-md text-color-gray-two">We help ambitious businesses navigate challenges, embrace innovation, and implement strategies that drive sustainable growth in an ever-changing market.</p>
          </div>
          <div page-load-2="" class="hero-button-block-v2">
            <PrimaryButton href="#" text="Free Consultation" variant="accent" />
          </div>
        </div>
        <div class="hero-image-wrap-v2">
          <div class="hero-image-block"><img src="/images/Hero-Image-1.webp" loading="lazy" sizes="100vw" srcset="/images/745bb64220889682029951f2c459832a_Hero-Image-1-p-500.webp 500w, /images/Hero-Image-1.webp 630w" alt="hero-image" class="hero-image"></div>
          <div class="hero-image-block"><img src="/images/Hero-Image-2.png" loading="lazy" sizes="100vw" srcset="/images/588039c8563cddee3b442a14c8b8d627_Hero-Image-2-p-500.png 500w, /images/Hero-Image-2.png 630w" alt="hero-image" class="hero-image"></div>
          <div class="hero-image-block"><img src="/images/Hero-Image-3.webp" loading="lazy" sizes="(max-width: 630px) 100vw, 630px" srcset="/images/6254204c7aad6facd102f53786d04c1b_Hero-Image-3-p-500.webp 500w, /images/Hero-Image-3.webp 630w" alt="hero-image" class="hero-image"></div>
        </div>
      </div>
    </div>
  </div>
</section>
