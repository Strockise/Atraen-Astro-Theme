# Copy to .env and replace every "tobemodified" value with a random secret
# (e.g. `node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"`).

# Server
HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (SQLite by default; set DATABASE_CLIENT=postgres|mysql and the DATABASE_* values for production)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false

# Built-in MCP server at /mcp (Strapi >= 5.47). Set to false to disable it.
STRAPI_MCP_ENABLED=true
