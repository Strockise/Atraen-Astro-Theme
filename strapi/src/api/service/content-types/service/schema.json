{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Consulting services shown on /service, /service/[slug] and the home page service tabs."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "order": { "type": "integer", "default": 0 },
    "number": { "type": "string" },
    "summary": { "type": "text" },
    "thumbnail": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "banner": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "heroSummary": { "type": "text" },
    "overview": { "type": "text" },
    "description": { "type": "text" },
    "audienceOne": { "type": "richtext" },
    "audienceTwo": { "type": "richtext" },
    "audienceThree": { "type": "richtext" },
    "audienceFour": { "type": "richtext" },
    "gallery": { "type": "media", "multiple": true, "allowedTypes": ["images"] }
  }
}
