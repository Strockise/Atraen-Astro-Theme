{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog",
    "description": "Blog posts shown on /blog, /blog/[slug] and the home page insights section."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "order": { "type": "integer", "default": 0 },
    "readTime": { "type": "string", "default": "5 Min" },
    "date": { "type": "date", "required": true },
    "mainImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "bannerImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "content": { "type": "richtext" },
    "seoDescription": { "type": "text" }
  }
}
