    "readTime": { "type": "string" },
    "date": { "type": "date" },
    "category": { "type": "string" },
    "author": { "type": "string" },
    "mainImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "bannerImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "detailsOne": { "type": "richtext" },
    "detailsTwo": { "type": "richtext" },
    "detailsThree": { "type": "richtext" }
  }
}
