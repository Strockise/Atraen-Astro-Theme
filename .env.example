# Public URL of the deployed site (canonical URLs, sitemap, Open Graph).
SITE_URL=https://example.com

# Strapi CMS (optional). Leave STRAPI_URL empty to build with the bundled demo content in src/data/.
STRAPI_URL=
# Read-only API token: Strapi admin > Settings > API Tokens > Create new API Token (type: Read-only).
STRAPI_API_TOKEN=

# Contact form endpoint (Formspree, Web3Forms, Basin, ... any endpoint that accepts a POSTed FormData).
PUBLIC_FORM_ENDPOINT=
