# Public URL of the deployed site (canonical URLs, sitemap, Open Graph).
SITE_URL=https://example.com

# Strapi CMS. Leave STRAPI_URL empty to build from the bundled demo content in src/data/.
STRAPI_URL=http://localhost:1337
# Optional read-only API token (Strapi → Settings → API Tokens). Not needed when the Public role can read.
STRAPI_API_TOKEN=

# Form endpoint for the newsletter and contact forms (Formspree, Web3Forms, Basin, your own API...).
# Leave empty for demo mode: forms show the success message without sending anything.
PUBLIC_FORM_ENDPOINT=
